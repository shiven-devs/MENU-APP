# MongoDB Atlas connection string (server-only)
MONGODB_URI=mongodb+srv://USER:PASS@CLUSTER.mongodb.net/menu-platform

# Auth.js — generate with: npx auth secret
AUTH_SECRET=replace-with-a-long-random-string
AUTH_URL=http://localhost:3000

# Absolute origin used when encoding table QR codes (server-only, not NEXT_PUBLIC_)
APP_URL=http://localhost:3000

# Cloudinary (server-only — uploads happen in a Server Action)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
